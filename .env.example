# ─────────────────────────────────────────────────────────────────────
# MindMatrix Environment Variables (.env.example)
# ─────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in actual values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────

# Authentication secret for API token generation/validation
# Change this to a strong random string in production
MINDMATRIX_AUTH_SECRET=your-auth-secret-here

# Salt for deterministic pseudonymization of identifiers
# Change this to a strong random string in production
PSEUDONYMIZATION_SALT=your-pseudonymization-salt-here

# Application environment (development | staging | production)
MINDMATRIX_ENV=development

# Optional: External API keys (if using cloud quantum hardware)
# IBM_QUANTUM_TOKEN=your-ibm-quantum-token-here
# AWS_BRAKET_ACCESS_KEY=your-aws-access-key-here

# Optional: Database URL (if using external storage)
# DATABASE_URL=your-database-url-here
